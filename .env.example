# MySQL 8 local, sans TLS. Le feature mysql-rsa de SQLx couvre caching_sha2_password.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/url_shortener

# Redis local.
REDIS_URL=redis://127.0.0.1:6379

# Préfixe des clés Redis (cache et rate limit).
REDIS_KEY_PREFIX=urlshort

# Secret HMAC du JWT. 32 caractères minimum.
JWT_SECRET=change-me-to-a-long-random-secret-value

# Durée de vie du JWT en secondes (défaut : 86400).
JWT_TTL_SECS=86400

# Adresse d'écoute (défaut : 127.0.0.1:8080).
BIND_ADDR=127.0.0.1:8080

# Origine utilisée pour construire short_url dans les réponses JSON.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# TTL du cache de redirection, en secondes (défaut : 300).
CACHE_TTL_SECS=300

# File d'attente et écriture par lots des clics.
CLICK_CHANNEL_CAPACITY=10000
CLICK_BATCH_SIZE=100
CLICK_FLUSH_INTERVAL_MS=500

# Fenêtre fixe de 60 secondes.
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=300

# N'honorer X-Forwarded-For que derrière un proxy de confiance.
TRUST_PROXY=false

# Taille du pool MySQL.
DB_MAX_CONNECTIONS=10
